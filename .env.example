# 正式環境必填。它一次決定四件事：docker-compose.prod.yml 裡的 app image tag、
# scripts/package-images.sh 產出的 tar 檔名中的版本、烙進 image 的版本，
# 以及 GET /health 在執行期回報的版本。compose 與 package-images.sh 都不再接受
# 未設定或 "latest"：兩次發版共用同一個 tag 會互相覆蓋彼此的 tar，讓人沒有舊 image 可回滾。
# 請使用這次要發布的 semver tag，例如 v0.1.0。
APP_VERSION=v0.1.0

# scripts/package-images.sh 寫出離線交付 tar 檔的位置。
# PACKAGE_OUTPUT_DIR=./release

# PostgreSQL（docker-compose 的 db 服務與 backend 都會用到）。正式環境請在第一次 `up -d`
# **之前**就設好真正的密碼：postgres 只在初始化 db_data volume 時才套用這些值，
# 之後再改完全沒有效果，除非刪掉 volume 從頭來過。
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_PORT=5432

# backend 透過這個 URL 連到 db。
# - 原生開發（uvicorn 跑在 host、db 在 Docker 裡）：使用 localhost
# - 完整 docker-compose（backend 本身也在 Docker 裡）：使用 host "db"
DATABASE_URL=postgresql+psycopg2://platform:platform@localhost:5432/platform

UPLOAD_DIR=./uploads
# 只用來填入每檔上傳上限的初始值；在那之後就由管理後台 UI（「站台設定」）掌管。
MAX_UPLOAD_SIZE_MB=50

# 驗證相關（請用例如 `openssl rand -hex 32` 產生一組真正的 secret）
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 選用：在啟動時建立第一個管理員帳號，因為 /api/admin/users 本身需要一個既有的管理員
# 才呼叫得動。只在尚無任何管理員帳號時生效；第一個管理員建立之後就讓它維持未設定。
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=change-me-to-a-real-password

# 選用：寄件用的 SMTP（自助重設密碼、上傳通知）。這些只在第一次讀取時，用來填入存於資料庫的
# `smtp_settings` 資料列的初始值；在那之後，SMTP 設定改由管理員透過 /admin 的
# 「Email SMTP 設定」分頁管理（見 app/api/smtp_settings.py），而不是這些環境變數。
# 若沒有啟用 SMTP，郵件會改為記錄下來而不寄出，這在本機開發與測試時完全夠用。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=no-reply@example.com
# SMTP_FROM=notifications@example.internal
# SMTP_USE_TLS=true

# 前端對外提供服務的 base URL，用來在郵件中組出指回前端的連結（例如重設密碼）。
# 正式環境必須填使用者實際連到本站的位址（例如 http://files.example.internal）——
# 若停留在開發預設值，每一封重設密碼信附的連結都沒有人打得開。
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# LDAP 驗證（選用）。這些只在第一次讀取時，用來填入存於資料庫的 `ldap_settings` 資料列的
# 初始值；在那之後，LDAP 設定改由管理員透過 /admin 的「LDAP 設定」分頁管理
# （見 app/api/ldap_settings.py），而不是這些環境變數。只用本機帳號的部署請讓
# LDAP_ENABLED 維持未設定或 false；底下這些欄位只有在它為 true 時才有意義。
# LDAP_ENABLED=true
# LDAP_SERVER_URI=ldap://ldap.example.internal
# LDAP_BIND_DN=cn=service-account,dc=example,dc=internal
# LDAP_BIND_PASSWORD=change-me
# LDAP_BASE_DN=ou=people,dc=example,dc=internal
# LDAP_USER_SEARCH_FILTER=(uid={username})

# 備份自動化（scripts/backup.sh，透過 host 的 crontab 對 docker-compose.prod.yml 的部署執行
# ——見 README 的「設定每日備份」）。刻意採用本機備份（pg_dump 加上 uploads/ 的 tar，
# 保留 BACKUP_RETENTION_DAYS 天）；異地或 NAS 傳輸不在本專案範圍內。預設關閉；
# 正式環境要啟用請設 BACKUP_ENABLED=true。
# BACKUP_ENABLED=false
# BACKUP_LOCAL_DIR=./backups
# BACKUP_RETENTION_DAYS=30

# 前端
VITE_API_BASE_URL=http://localhost:8000
