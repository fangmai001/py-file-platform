# Build context for the root Dockerfile is the whole repo, so everything large or
# host-specific has to be excluded explicitly - notably backend/venv, which would
# otherwise be copied into the image by `COPY backend/ .`.
.git
.github
.claude
.vscode

backend/venv
**/__pycache__
**/*.pyc
.pytest_cache

frontend/node_modules
frontend/dist

# Runtime data and secrets: uploads are bind-mounted at run time, and .env is read
# from the host via env_file rather than baked into the image.
uploads
backups
.env

docs
*.md
